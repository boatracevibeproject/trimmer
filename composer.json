{
    "name": "bvp/trimmer",
    "description": "Recursively trims whitespace (or custom characters) from strings, including strings nested inside arrays of any depth.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "boatrace",
        "library",
        "trimmer"
    ],
    "authors": [
        {
            "name": "shimomo",
            "email": "bvp@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/boatracevibeproject/trimmer/issues",
        "source": "https://github.com/boatracevibeproject/trimmer"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "phpunit/phpunit": "^10.5.62 || ^11.5.50 || ^12.5.8 || ^13.0",
        "vimeo/psalm": "^5.0 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\Trimmer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\Trimmer\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
